# Zmienne stosu Biddy w Dokploy (zakładka Environment usługi Compose). Szablon do skopiowania:
# uzupełnij wartości i wklej całość w panelu. Opis kroków: docs/deployment-dokploy.md.
# Plik w repozytorium zawiera tylko przykłady; prawdziwe sekrety trzymaj wyłącznie w Dokploy.

# --- Wersja i środowisko -----------------------------------------------------------------------
# `staging` albo `production`: prefiks nazw wewnętrznych, indeksu wyszukiwarki, Sentry i obrazu
# web (biddy-web-<środowisko>).
BIDDY_ENV=staging
# Rejestr obrazów (GHCR właściciela repozytorium, małymi literami).
BIDDY_REGISTRY=ghcr.io/bembnias
# `staging` = najnowszy obraz z main. Wycofanie: `sha-<pełny SHA commita>` i Deploy.
BIDDY_TAG=staging

# --- Adresy ------------------------------------------------------------------------------------
WEB_URL=https://staging.biddy.pl
API_PUBLIC_URL=https://api.staging.biddy.pl
# Ciasteczko sesji wspólne dla web i API (domena bez protokołu).
AUTH_COOKIE_DOMAIN=staging.biddy.pl
# Swagger UI pod /docs (na stagingu tak, na produkcji nie).
OPENAPI_ENABLED=true

# --- Baza danych (Dokploy → Databases → biddy-postgres → Internal Connection URL) -------------
DATABASE_URL=postgresql://biddy:HASLO@biddy-postgres-xxxxxx:5432/biddy

# --- Sekrety aplikacji (każdy: openssl rand -base64 32) ----------------------------------------
BETTER_AUTH_SECRET=
WEB_REVALIDATE_SECRET=
# Klucz główny Meilisearch na tym serwerze (wyszukiwarka nie jest dostępna z internetu).
MEILI_MASTER_KEY=

# --- Pliki: Cloudflare R2 (docs/deployment.md, „Cloudflare R2”) --------------------------------
S3_ENDPOINT=https://ID_KONTA.eu.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_MEDIA=biddy-staging-media
S3_BUCKET_UPLOADS=biddy-staging-uploads
MEDIA_PUBLIC_URL=https://media.staging.biddy.pl

# --- Usługi zewnętrzne -------------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=Biddy Staging <no-reply@staging.biddy.pl>
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SMSAPI_TOKEN=
# Nazwa nadawcy wymaga rejestracji w SMSAPI; do tego czasu puste.
SMSAPI_SENDER=
# Sentry (projekt biddy-api); puste = bez raportowania błędów.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
LOG_LEVEL=info

# --- Logowanie społecznościowe (parami albo puste) ---------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
