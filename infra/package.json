{
  "name": "@biddy/infra",
  "version": "0.0.0",
  "private": true,
  "description": "Lokalna infrastruktura (docker compose) i skrypty deweloperskie",
  "type": "module",
  "scripts": {
    "bootstrap": "tsx scripts/bootstrap.ts",
    "env:check": "tsx scripts/env-check.ts",
    "infra:up": "tsx scripts/infra-up.ts",
    "infra:down": "tsx scripts/compose-run.ts down",
    "infra:logs": "tsx scripts/compose-run.ts logs -f",
    "infra:reset": "tsx scripts/compose-run.ts down -v",
    "db:reset": "tsx scripts/db-reset.ts",
    "storage:setup": "tsx scripts/storage-setup.ts",
    "mail:test": "tsx scripts/mail-test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "nodemailer": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biddy/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
