{
  "name": "biddy",
  "private": true,
  "description": "Biddy: marketplace C2C z licytacjami czasowymi i Pakietem Ochrony Kupujących",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm infra:up && turbo run dev dev:worker dev:board",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "api:generate": "pnpm --filter @biddy/api openapi:export && pnpm --filter @biddy/api-client generate",
    "api:check": "pnpm --filter @biddy/api-client check:generated",
    "check": "turbo run lint typecheck test && pnpm format:check && pnpm api:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules/.cache",
    "bootstrap": "pnpm --filter @biddy/infra run bootstrap",
    "env:check": "pnpm --filter @biddy/infra run env:check",
    "infra:up": "pnpm --filter @biddy/infra run infra:up",
    "infra:down": "pnpm --filter @biddy/infra run infra:down",
    "infra:logs": "pnpm --filter @biddy/infra run infra:logs",
    "infra:reset": "pnpm --filter @biddy/infra run infra:reset",
    "app:up": "pnpm infra:up && pnpm storage:setup && docker compose -f infra/docker-compose.yml -f infra/docker-compose.app.yml up -d --build --wait",
    "app:down": "docker compose -f infra/docker-compose.yml -f infra/docker-compose.app.yml down",
    "app:logs": "docker compose -f infra/docker-compose.yml -f infra/docker-compose.app.yml logs -f api worker web",
    "db:reset": "pnpm --filter @biddy/infra run db:reset",
    "storage:setup": "pnpm --filter @biddy/infra run storage:setup",
    "mail:test": "pnpm --filter @biddy/infra run mail:test"
  },
  "devDependencies": {
    "@biddy/config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "catalog:"
  },
  "prettier": "@biddy/config/prettier"
}
