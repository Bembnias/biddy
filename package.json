{
  "name": "biddy",
  "private": true,
  "description": "Biddy: marketplace C2C z licytacjami czasowymi i Pakietem Ochrony Kupujących",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm infra:up && turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test && pnpm format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules/.cache",
    "setup": "pnpm --filter @biddy/infra run setup",
    "env:check": "pnpm --filter @biddy/infra run env:check",
    "infra:up": "pnpm --filter @biddy/infra run infra:up",
    "infra:down": "pnpm --filter @biddy/infra run infra:down",
    "infra:logs": "pnpm --filter @biddy/infra run infra:logs",
    "infra:reset": "pnpm --filter @biddy/infra run infra:reset",
    "db:reset": "pnpm --filter @biddy/infra run db:reset",
    "storage:setup": "pnpm --filter @biddy/infra run storage:setup",
    "mail:test": "pnpm --filter @biddy/infra run mail:test"
  },
  "devDependencies": {
    "@biddy/config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "catalog:"
  },
  "prettier": "@biddy/config/prettier"
}
