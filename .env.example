# =============================================================================
# Biddy: zmienne środowiskowe do lokalnego developmentu
# =============================================================================
#
# Pierwsze uruchomienie: `pnpm bootstrap` skopiuje ten plik do .env. Ręcznie:
#   cp .env.example .env
# Wartości poniżej działają od razu z infra/docker-compose.yml. Sprawdzenie: `pnpm env:check`.
#
# Zasady:
# - .env nie trafia do repozytorium (.gitignore). Ten plik to szablon, bez prawdziwych sekretów.
# - Zmienne ustawione w powłoce mają pierwszeństwo przed .env (tak samo działa docker compose).
# - Wartość ze spacją ujmij w cudzysłów. Wartość ze znakiem $ albo # ujmij w POJEDYNCZE
#   cudzysłowy (np. POSTGRES_PASSWORD='abc$def#1'): docker compose podstawia $ZMIENNA, a skrypty
#   ucinają wartość na #. `pnpm env:check` zgłosi wartość, którą odczytałyby różnie.
# - Port zajęty przez inny program? Zmień zmienną *_PORT ORAZ ten sam port w powiązanym
#   adresie URL (np. POSTGRES_PORT i DATABASE_URL). `pnpm env:check` wykryje niezgodność.
#
# Produkcja nie korzysta z tego pliku: Postgres i Redis to usługi Render (Frankfurt), pliki
# trzyma Cloudflare R2, wyszukiwarka to Meilisearch Cloud (EU), maile wysyła Resend. Sekrety
# produkcyjne są w zmiennych środowiskowych platform (PROJECT.md §11.6).

# --- Ogólne ------------------------------------------------------------------
# development | test | production. `pnpm db:reset` i `pnpm storage:setup` odmawiają przy production.
NODE_ENV=development

# --- PostgreSQL 17 -----------------------------------------------------------
# Kontener tworzy użytkownika i bazę przy pierwszym starcie (pusty wolumen). Zmiana tych
# wartości później wymaga `pnpm infra:reset` (usuwa dane) albo ręcznej zmiany w bazie.
POSTGRES_USER=biddy
POSTGRES_PASSWORD=biddy
POSTGRES_DB=biddy
POSTGRES_PORT=5432
# Adres używany przez API, migracje i `pnpm db:reset` (użytkownik, hasło i port jak wyżej).
# Znaki specjalne w haśle zakoduj w adresie: % jako %25, @ jako %40, # jako %23.
DATABASE_URL=postgres://biddy:biddy@localhost:5432/biddy

# --- Redis: dwie osobne instancje (PROJECT.md §11.2) -------------------------
# Kolejki BullMQ: AOF i noeviction (eviction gubiłby joby).
REDIS_QUEUE_PORT=6379
REDIS_QUEUE_URL=redis://localhost:6379
# Cache, rate limit i pub/sub Socket.IO: allkeys-lru, limit 256 MB, bez persystencji.
REDIS_CACHE_PORT=6380
REDIS_CACHE_URL=redis://localhost:6380

# --- Meilisearch (wyszukiwarka) ----------------------------------------------
MEILI_PORT=7700
MEILI_URL=http://localhost:7700
# Klucz główny lokalnego kontenera, min. 16 znaków. API i worker używają go, gdy nie podano
# MEILI_API_KEY (sekcja API). Na produkcji klucze z Meilisearch Cloud.
MEILI_MASTER_KEY=biddy-local-meili-master-key

# --- Pliki: RustFS jako lokalny S3 (na produkcji Cloudflare R2) ---------------
# Port API S3 i port konsoli WWW (konsola: http://localhost:9001/rustfs/console/).
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
# RustFS używa regionu us-east-1, Cloudflare R2 regionu "auto".
S3_REGION=us-east-1
# Klucze dostępu S3, a jednocześnie login i hasło do konsoli RustFS.
S3_ACCESS_KEY_ID=biddy-local
S3_SECRET_ACCESS_KEY=biddy-local-secret
# Adresy w stylu ścieżki (http://host/kubełek/klucz). RustFS bez skonfigurowanej domeny
# obsługuje tylko ten styl.
S3_FORCE_PATH_STYLE=true
# Kubełek publiczny (za CDN) na przetworzone zdjęcia: tylko warianty bez metadanych EXIF.
S3_BUCKET_MEDIA=biddy-media
# Kubełek prywatny na dokumenty: etykiety, dowody w sporach, faktury.
S3_BUCKET_DOCUMENTS=biddy-documents
# Kubełek prywatny na oryginały zdjęć (upload z przeglądarki przez presigned PUT, z EXIF)
# i zdjęcia zatrzymane przez moderację (F-12).
S3_BUCKET_UPLOADS=biddy-uploads
# Originy (po przecinku), z których przeglądarka może wysyłać pliki do kubełka uploads (PUT)
# i czytać kubełek media (GET, HEAD); reguły CORS ustawia `pnpm storage:setup`.
S3_CORS_ORIGINS=http://localhost:3000

# --- Poczta: Mailpit (na produkcji Resend) -----------------------------------
# Serwer SMTP Mailpit przyjmuje każdy mail i niczego nie wysyła dalej.
SMTP_HOST=localhost
SMTP_PORT=1025
# Mailpit przyjmuje dowolny login i hasło albo ich brak. Odkomentuj, żeby testować logowanie SMTP.
# SMTP_USER=biddy
# SMTP_PASSWORD=biddy
MAIL_FROM="Biddy <no-reply@biddy.local>"
# Podgląd przechwyconych maili w przeglądarce.
MAILPIT_UI_PORT=8025
MAILPIT_UI_URL=http://localhost:8025

# --- API (apps/api) -----------------------------------------------------------
# Wartości poniżej to wartości domyślne API w development, dlatego są zakomentowane:
# odkomentuj zmienną, żeby ją zmienić. API korzysta też z NODE_ENV i DATABASE_URL (wyżej).
# Błędna wartość zatrzymuje start API z listą wszystkich złych zmiennych.
#
# Port HTTP API (web działa na 3000). Platforma (Render) podaje własny PORT, który wygrywa.
# API_PORT=3001
# Originy frontendu (po przecinku), które mogą wołać API z ciasteczkami (CORS).
# Na produkcji zmienna jest wymagana.
# CORS_ORIGINS=http://localhost:3000
# Poziom logów: fatal | error | warn | info | debug | trace | silent.
# Domyślnie debug w development, info w pozostałych środowiskach.
# LOG_LEVEL=debug
# Zaufane proxy przed API (adres klienta z X-Forwarded-For): false, true albo lista adresów
# IP/CIDR po przecinku (zakresy: loopback, linklocal, uniquelocal). Domyślnie false, a na
# produkcji loopback,uniquelocal (load balancer Render w sieci prywatnej). Proxy z publicznymi
# adresami (np. Cloudflare przed Render) dopisz do listy. true ufa każdemu wpisowi nagłówka.
# TRUST_PROXY=false
# Swagger UI pod /docs i dokument JSON pod /docs/json (domyślnie wyłączone na produkcji).
# OPENAPI_ENABLED=true
#
# Kolejki (API i worker, `pnpm dev:worker`). Adres Redisa kolejek to REDIS_QUEUE_URL z sekcji
# Redis wyżej; na produkcji jest wymagany, a instancja musi mieć maxmemory-policy noeviction
# (inaczej worker nie startuje).
# Prefiks kluczy BullMQ w Redisie: osobne przestrzenie kolejek na jednej instancji.
# QUEUE_PREFIX=biddy
# Co ile milisekund relay outboxa (w workerze) sprawdza nowe eventy, gdy nie ma zaległości.
# OUTBOX_POLL_INTERVAL_MS=250
# Port Bull Board, podglądu kolejek w przeglądarce (`pnpm dev:board`, tylko poza produkcją).
# BULL_BOARD_PORT=3002
# DSN projektu Sentry. Pusty albo brak = Sentry wyłączone (lokalnie zwykle nie jest potrzebne).
# SENTRY_DSN=
#
# Konta i logowanie (Better Auth pod /v1/auth/*). Na produkcji wymagane: BETTER_AUTH_SECRET,
# API_PUBLIC_URL, WEB_URL i klucze Turnstile.
# Sekret podpisywania sesji (min. 32 znaki, np. `openssl rand -base64 32`). Lokalnie stały
# sekret deweloperski; jego zmiana unieważnia wszystkie sesje.
# BETTER_AUTH_SECRET=
# Publiczny adres API (linki w e-mailach, callbacki Google i Apple). Domyślnie localhost z API_PORT.
# API_PUBLIC_URL=http://localhost:3001
# Adres aplikacji web (powrót po weryfikacji e-maila i resecie hasła, zaufany origin).
# WEB_URL=http://localhost:3000
# Wspólna domena ciasteczka sesji dla web i API na subdomenach (np. biddy.pl dla biddy.pl
# i api.biddy.pl). Lokalnie zbędna: localhost:3000 i localhost:3001 to ten sam host.
# AUTH_COOKIE_DOMAIN=
# Logowanie przez Google i Apple: przycisk pojawia się, gdy podano parę ID i sekret.
# Callback: <API_PUBLIC_URL>/v1/auth/callback/google (oraz /apple).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# Bundle ID aplikacji iOS (logowanie Apple natywnie w aplikacji mobilnej).
# APPLE_APP_BUNDLE_ID=
# Cloudflare Turnstile (rejestracja, reset hasła, logowanie po 5 nieudanych próbach). Domyślnie
# klucze testowe Cloudflare: widżet zawsze przechodzi, a API sprawdza token bez sieci.
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#
# E-maile (weryfikacja adresu, reset hasła) wysyła worker z kolejki `emails`. Bez klucza Resend
# idą przez SMTP z sekcji Poczta (lokalnie Mailpit); na produkcji klucz jest wymagany.
# RESEND_API_KEY=
#
# SMS-y z kodami weryfikacji telefonu (SMSAPI.pl). Bez tokenu atrapa: kod trafia do logu API
# („SMS (atrapa) do +48…”). Na produkcji token jest wymagany.
# SMSAPI_TOKEN=
# Atrapa mimo ustawionego tokenu (np. staging do czasu aktywacji konta w SMSAPI): kod w logu API,
# bez wysyłki. Na produkcji odrzucane.
# SMS_LOG_ONLY=false
# Nazwa nadawcy SMS (do 11 znaków, wymaga rejestracji w SMSAPI). Pusta = domyślny nadawca konta.
# SMSAPI_SENDER=
#
# Zdjęcia (F-12): API podpisuje upload do kubełka uploads, a worker zapisuje przetworzone warianty
# w kubełku media. Oba używają zmiennych S3_* z sekcji Pliki; na produkcji wymagane są S3_ENDPOINT,
# klucze dostępu i MEDIA_PUBLIC_URL.
# Publiczny adres kubełka media (na produkcji własna domena R2 za CDN), początek adresów zdjęć.
# Domyślnie S3_ENDPOINT/S3_BUCKET_MEDIA.
# MEDIA_PUBLIC_URL=http://localhost:9000/biddy-media
#
# Anti-sniping (PROJECT.md §6.5): oferta w ostatnich N sekundach aukcji, która zmienia cenę albo
# lidera, przesuwa koniec na teraz + N sekund (bez limitu przedłużeń). 0 wyłącza przedłużenia.
# AUCTION_ANTI_SNIPING_SECONDS=120
#
# Wyszukiwarka (F-19): adres Meilisearch z sekcji wyżej (MEILI_URL) i klucz API. Lokalnie klucz
# główny kontenera (MEILI_MASTER_KEY); na produkcji MEILI_URL i MEILI_API_KEY są wymagane w API
# i workerze (klucz z uprawnieniami do indeksu aukcji: wyszukiwanie, dokumenty, ustawienia, zadania).
# MEILI_API_KEY=
# Prefiks nazw indeksów (indeks aukcji: <prefiks>-auctions). Staging i produkcja mogą dzielić
# jeden projekt Meilisearch, jeśli mają różne prefiksy.
# SEARCH_INDEX_PREFIX=biddy
#
# Strony aukcji w web (F-18): po ofercie, zakończeniu albo zmianie aukcji worker woła
# POST <WEB_URL>/api/revalidate z tym sekretem (najwyżej raz na 5 s na stronę). Ta sama wartość
# co WEB_REVALIDATE_SECRET w web. Pusty = bez rewalidacji (strony odświeżają się co 60 s); na
# produkcji wymagany w workerze.
# WEB_REVALIDATE_SECRET=
#
# Płatności (F-23, PROJECT.md §7.8). Środowisko wdrożenia: local | preview | staging | production.
# Staging działa z NODE_ENV=production, więc musi mieć DEPLOYMENT_ENV=staging. Bez tej zmiennej
# produkcyjne NODE_ENV oznacza produkcję, na której FakeGateway (`fake`) nie wystartuje.
# DEPLOYMENT_ENV=local
# Operator nowych płatności. Poza produkcją domyślnie FakeGateway; na produkcji wymagany.
# PAYMENTS_DEFAULT_PROVIDER=fake
# Dokąd worker wysyła webhooki FakeGateway. Domyślnie API_PUBLIC_URL + /v1/webhooks/payments/fake;
# worker na stagingu bez API_PUBLIC_URL musi dostać adres API (np. wewnętrzny adres usługi).
# PAYMENTS_FAKE_WEBHOOK_URL=http://localhost:3001/v1/webhooks/payments/fake
# Opóźnienie rozliczenia płatności i webhooka FakeGateway (symulacja potwierdzenia w banku).
# PAYMENTS_FAKE_WEBHOOK_DELAY_MS=2000
# Klucz szyfrowania danych do wypłat (F-27: dane DAC7 i rachunek), 32 bajty w base64
# (`openssl rand -base64 32`). Na produkcji wymagany w API i workerze, lokalnie stały klucz
# deweloperski. Nie zmieniaj go po zapisaniu danych: bez starego klucza nie da się ich odczytać.
# DATA_ENCRYPTION_KEY=
#
# Dostawy (F-24, PROJECT.md §8). Dostawca nowych przesyłek: fake | furgonetka. Poza produkcją
# domyślnie FakeShipping; na produkcji wymagany i różny od `fake`.
# SHIPPING_DEFAULT_PROVIDER=fake
# Dokąd worker wysyła webhooki FakeShipping. Domyślnie API_PUBLIC_URL + /v1/webhooks/shipping/fake;
# worker na stagingu bez API_PUBLIC_URL musi dostać adres API (jak przy FakeGateway).
# SHIPPING_FAKE_WEBHOOK_URL=http://localhost:3001/v1/webhooks/shipping/fake
# Odstęp między statusami automatu FakeShipping (cały cykl około 2 minuty); 0 wyłącza automat.
# SHIPPING_FAKE_STEP_DELAY_MS=20000
# Furgonetka: podaj wszystkie zmienne poniżej albo żadnej (adapter wyłączony). Adres API: sandbox
# poza produkcją, https://api.furgonetka.pl na produkcji. Konto loguje się raz (grant password),
# potem API i worker odświeżają token zapisany w bazie. Token webhooków jest w ustawieniach konta.
# FURGONETKA_API_URL=https://api.sandbox.furgonetka.pl
# FURGONETKA_CLIENT_ID=
# FURGONETKA_CLIENT_SECRET=
# FURGONETKA_USERNAME=
# FURGONETKA_PASSWORD=
# FURGONETKA_WEBHOOK_TOKEN=

# --- Web (apps/web) -----------------------------------------------------------
# Wartości poniżej to wartości domyślne lokalnie, dlatego są zakomentowane. Zmienne NEXT_PUBLIC_*
# Next.js wkleja do kodu przy buildzie, więc trafiają do przeglądarki: nie umieszczaj w nich
# sekretów. Zmiana wymaga ponownego `pnpm build` (w `pnpm dev` wystarczy restart).
# Na Vercel preview deployment sam dostaje środowisko `preview` i adres strony, a release to SHA
# commita (zmienne systemowe VERCEL_*); konfiguracja środowisk: docs/deployment.md.
#
# Środowisko: local | preview | staging | production. Tylko production pozwala wyszukiwarkom
# indeksować stronę (robots.txt); poza local adresy API i strony są wymagane.
# NEXT_PUBLIC_ENVIRONMENT=local
# Adres API (bez /v1), z którym rozmawia przeglądarka.
# NEXT_PUBLIC_API_URL=http://localhost:3001
# Adres API dla renderowania na serwerze (Server Components), np. w sieci prywatnej. Zmienna
# serwerowa, czytana przy starcie (bez ponownego buildu); domyślnie NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=
# Publiczny adres aplikacji web (metadata, Open Graph).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sekret rewalidacji stron aukcji (POST /api/revalidate, F-18), ten sam co w workerze API. Zmienna
# serwerowa (bez NEXT_PUBLIC_), czytana przy żądaniu. Pusty = rewalidacja wyłączona (503).
# WEB_REVALIDATE_SECRET=
# DSN projektu Sentry dla web. Pusty albo brak = Sentry wyłączone.
# NEXT_PUBLIC_SENTRY_DSN=
# Klucz projektu PostHog (EU). Analityka startuje tylko po zgodzie użytkownika (F-41).
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
