        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "Adresy zalogowanego użytkownika",
        "tags": [
          "me"
        ]
      },
      "post": {
        "description": "Pierwszy adres staje się domyślny do dostawy i nadania. Najwyżej 10 adresów (409 ADDRESS_LIMIT_REACHED).",
        "operationId": "createAddress",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAddressDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Zapisany adres",
            "content": {
