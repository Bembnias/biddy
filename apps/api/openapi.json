            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "Akceptacja aktualnych wersji regulaminu i polityki prywatności z oświadczeniem 18+",
        "tags": [
          "me"
        ]
      }
    },
