    "/v1/me/phone-verification": {
      "post": {
        "description": "Polskie numery komórkowe. Kod ważny 5 minut. Limity: kolejny SMS po 60 s, 3 na numer na godzinę, 10 z adresu IP na godzinę, 10 na konto na dobę (429 RATE_LIMITED z Retry-After). Numer innego konta: 409 PHONE_NUMBER_TAKEN (bez SMS-a).",
        "operationId": "startPhoneVerification",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartPhoneVerificationDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Kod wysłany",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhoneVerificationDto"
                }
              }
            }
          },
          "default": {
            "description": "Błąd: Problem Details (RFC 9457, application/problem+json); rozpoznawaj go po polu code.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "Wysłanie kodu SMS na numer telefonu",
        "tags": [
          "me"
        ]
      }
    },
    "/v1/me/phone-verification/confirm": {
      "post": {
        "description": "Maks. 5 prób na kod: zły kod to 400 PHONE_CODE_INVALID z `remainingAttempts`, brak aktywnego kodu (wygasł, limit prób, wysłano nowszy) to 400 PHONE_CODE_EXPIRED. Nowy numer zastępuje poprzedni.",
        "operationId": "confirmPhoneVerification",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmPhoneVerificationDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Numer zweryfikowany",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifiedPhoneDto"
                }
              }
            }
          },
          "default": {
            "description": "Błąd: Problem Details (RFC 9457, application/problem+json); rozpoznawaj go po polu code.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "Potwierdzenie numeru kodem z SMS-a",
        "tags": [
          "me"
        ]
      }
    },
