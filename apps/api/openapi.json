  "info": {
    "title": "Biddy API",
    "description": "REST API Biddy. Błędy mają format Problem Details (RFC 9457) z polem `code`; każda odpowiedź ma nagłówek x-request-id.",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "biddy.session_token",
        "description": "Sesja web: ciasteczko HttpOnly ustawiane przy logowaniu (/v1/auth/sign-in/email); na produkcji z prefiksem __Secure-."
      },
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Sesja mobile: token z nagłówka set-auth-token odpowiedzi logowania."
      }
    },
    "schemas": {
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string",
            "description": "Imię wyświetlane"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "emailVerified": {
            "type": "boolean",
            "description": "Czy adres e-mail jest potwierdzony (wymagane do licytowania i wystawiania)"
          },
          "termsAccepted": {
            "type": "boolean",
            "description": "Czy użytkownik zaakceptował aktualne wersje regulaminu i polityki prywatności"
          },
          "phoneNumber": {
            "type": "string",
            "format": "e164",
            "pattern": "^\\+[1-9]\\d{6,14}$",
            "description": "Zweryfikowany numer telefonu (E.164) albo null",
            "nullable": true
          },
          "phoneVerified": {
            "type": "boolean",
            "description": "Czy numer telefonu jest zweryfikowany (wymagane do licytowania i wystawiania)"
          },
          "staffRole": {
            "type": "string",
            "enum": [
              "support",
              "moderator",
              "finance",
              "admin",
              null
            ],
            "description": "Rola wewnętrzna (panel administracyjny) albo null",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "emailVerified",
          "termsAccepted",
          "phoneNumber",
          "phoneVerified",
          "staffRole",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "description": "Imię wyświetlane (2–60 znaków, bez danych kontaktowych)"
          }
        },
        "required": [
          "name"
        ]
      },
      "AcceptTermsDto": {
        "type": "object",
        "properties": {
          "adultDeclaration": {
            "type": "boolean",
            "description": "Oświadczenie, że użytkownik ma ukończone 18 lat",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "adultDeclaration"
        ]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "name": {
                "type": "string"
              },
              "emailVerified": {
                "type": "boolean"
              },
              "termsAccepted": {
                "type": "boolean"
              },
              "phoneVerified": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "emailVerified",
              "termsAccepted",
              "phoneVerified"
            ],
            "additionalProperties": false,
            "description": "Zalogowany użytkownik albo null (gość)",
            "nullable": true
          }
        },
        "required": [
          "user"
        ],
        "additionalProperties": false
      },
      "AuthOptionsDto": {
        "type": "object",
        "properties": {
          "socialProviders": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "google",
                "apple"
              ]
            },
            "description": "Włączone logowanie przez dostawców (przyciski w formularzu)"
          },
          "turnstileSiteKey": {
            "type": "string",
            "description": "Klucz witryny Cloudflare Turnstile dla widżetu"
          },
          "passwordMinLength": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Minimalna długość hasła"
          }
        },
        "required": [
          "socialProviders",
          "turnstileSiteKey",
          "passwordMinLength"
        ],
        "additionalProperties": false
      },
      "StartPhoneVerificationDto": {
        "type": "object",
        "properties": {
          "phoneNumber": {
            "type": "string",
            "maxLength": 32,
            "description": "Polski numer komórkowy w dowolnym zapisie, np. `500 600 700` albo `+48500600700`"
          }
        },
        "required": [
          "phoneNumber"
        ]
      },
      "PhoneVerificationDto": {
        "type": "object",
        "properties": {
          "phoneNumber": {
            "type": "string",
            "format": "e164",
            "pattern": "^\\+[1-9]\\d{6,14}$",
            "description": "Numer w formacie E.164, na który wysłano kod"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "Do kiedy kod jest ważny"
          },
          "resendAvailableAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "Od kiedy można wysłać kolejny kod"
          }
        },
        "required": [
          "phoneNumber",
          "expiresAt",
          "resendAvailableAt"
        ],
        "additionalProperties": false
      },
      "ConfirmPhoneVerificationDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "description": "Kod z SMS-a"
          }
        },
        "required": [
          "code"
        ]
      },
      "VerifiedPhoneDto": {
        "type": "object",
        "properties": {
          "phoneNumber": {
            "type": "string",
            "format": "e164",
